{
  "name": "plainpage",
  "productName": "Plainpage",
  "desktopName": "plainpage.desktop",
  "version": "0.19.1",
  "description": "A markdown editor. Free, open source, file-first, focused on typography and feel.",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "pack:app": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "build:store": "FOOLSCAP_EDITION=store electron-vite build",
    "dist:store": "node scripts/dist-store.cjs",
    "release": "node scripts/dist-plainpage.cjs",
    "test:coverage": "vitest run --coverage",
    "e2e": "node scripts/e2e/run.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/bitter": "^5.3.0",
    "@fontsource-variable/crimson-pro": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/recursive": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@shikijs/rehype": "^4.5.0",
    "@vitest/coverage-v8": "^4.1.11",
    "chokidar": "^5.0.0",
    "electron": "^43.7.11",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "author": "Seánan",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
